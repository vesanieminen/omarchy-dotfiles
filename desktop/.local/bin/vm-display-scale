#!/usr/bin/env python3
"""Scale virtual outputs from their actual pixel height, retaining mode/layout."""
import json
import subprocess


def scale_updates(monitors):
    for monitor in monitors:
        if not monitor["name"].startswith("Virtual-") or monitor.get("disabled"):
            continue
        desired = 2 if monitor["height"] >= 1800 else 1
        # Integer 2x cannot represent odd physical dimensions exactly.
        if desired == 2 and (monitor["width"] % 2 or monitor["height"] % 2):
            desired = 1
        if monitor["scale"] == desired:
            continue
        yield {
            "output": monitor["name"],
            "mode": f'{monitor["width"]}x{monitor["height"]}@{monitor["refreshRate"]:.5f}',
            "position": f'{monitor["x"]}x{monitor["y"]}',
            "scale": desired,
            "transform": monitor.get("transform", 0),
        }


def main():
    monitors = json.loads(subprocess.check_output(["hyprctl", "-j", "monitors"]))
    for config in scale_updates(monitors):
        fields = ", ".join(f"{key} = {json.dumps(value)}" for key, value in config.items())
        subprocess.run(["hyprctl", "eval", "hl.monitor({ " + fields + " })"], check=True)


if __name__ == "__main__":
    main()
