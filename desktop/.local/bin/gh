#!/usr/bin/env bash
set -euo pipefail
# Optional personal PAT; otherwise keep gh's existing native keyring login.
if [[ -z ${GH_TOKEN:-} ]] && command -v secret-tool >/dev/null 2>&1; then
  GH_TOKEN=$(secret-tool lookup service github-cli host github.com user "$(id -un)" || true)
  [[ -z ${GH_TOKEN} ]] || export GH_TOKEN
fi
# Use the version selected by official Omarchy's Mise configuration.
exec mise exec gh -- gh "$@"
