#!/usr/bin/env bash

set -euo pipefail

state_file=${SPICE_DISPLAY_STATE:-${XDG_STATE_HOME:-${HOME}/.local/state}/spice-guest-tools/display.state}
[[ -r ${state_file} ]] || exit 0

# Resume and host-display transitions can emit several intermediate layouts in
# a few hundred milliseconds. Act only on the final state in the burst.
sleep "${SPICE_SCALE_SETTLE_SECONDS:-0.5}"
state_contents=$(<"${state_file}")
monitors_json=$(hyprctl -j monitors all)

declare -A outputs=()
declare -A modelines=()
declare -A positions_x=()
declare -A positions_y=()

while IFS='=' read -r key value; do
  if [[ ${key} =~ ^monitor\.([0-9]+)\.(output|modeline|x|y)$ ]]; then
    index=${BASH_REMATCH[1]}
    field=${BASH_REMATCH[2]}
    case ${field} in
      output) outputs[${index}]=${value} ;;
      modeline) modelines[${index}]=${value} ;;
      x) positions_x[${index}]=${value} ;;
      y) positions_y[${index}]=${value} ;;
    esac
  fi
done <<<"${state_contents}"

mapfile -t indexes < <(printf '%s\n' "${!outputs[@]}" | sort -n)
lua_command='do '
change_count=0

for index in "${indexes[@]}"; do
  output=${outputs[${index}]:-}
  modeline=${modelines[${index}]:-}
  position_x=${positions_x[${index}]:-}
  position_y=${positions_y[${index}]:-}

  [[ ${output} =~ ^[A-Za-z0-9._-]+$ ]] || continue
  [[ ${modeline} =~ ^[A-Za-z0-9.+[:space:]-]+$ ]] || continue
  [[ ${position_x} =~ ^-?[0-9]+$ ]] || continue
  [[ ${position_y} =~ ^-?[0-9]+$ ]] || continue

  height=$(awk '{ if (NF >= 6) print $6 }' <<<"${modeline}")
  [[ ${height} =~ ^[0-9]+$ ]] || continue

  desired_scale=1
  if ((height >= 1800)); then
    desired_scale=2
  fi

  current_scale=$(jq -r --arg output "${output}" \
    'first(.[] | select(.name == $output) | .scale) // empty' \
    <<<"${monitors_json}")
  [[ ${current_scale} =~ ^[0-9]+([.][0-9]+)?$ ]] || continue
  awk -v current="${current_scale}" -v desired="${desired_scale}" \
    'BEGIN { exit !(current == desired) }' && continue

  printf -v lua_command \
    '%shl.monitor({ output = "%s", mode = "modeline %s", position = "%sx%s", scale = %s }); ' \
    "${lua_command}" "${output}" "${modeline}" "${position_x}" "${position_y}" "${desired_scale}"
  change_count=$((change_count + 1))
done

if ((change_count > 0)); then
  # Do not apply a stale layout if another SPICE request arrived while preparing.
  [[ $(<"${state_file}") == "${state_contents}" ]] || exit 0

  lua_command+='end'
  hyprctl -r eval "${lua_command}"
fi

# Temporary workaround: SPICE can briefly pair an odd-sized mode with scale 2
# before this post-processing helper runs. Clear only the resulting stale error
# banner, without reloading Hyprland. Remove this after the bridge applies a
# compatible mode and scale atomically.
if [[ -z $(hyprctl configerrors) ]]; then
  hyprctl seterror disable >/dev/null
fi
