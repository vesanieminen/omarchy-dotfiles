#!/usr/bin/env python3
"""Select the Omarchy theme for daylight or darkness in Helsinki."""

import calendar
import datetime as dt
import math
import pathlib
import subprocess
from zoneinfo import ZoneInfo


LATITUDE = math.radians(60.1699)
LONGITUDE = 24.9384
HELSINKI = ZoneInfo("Europe/Helsinki")
CURRENT_THEME = pathlib.Path.home() / ".local/state/omarchy/current/theme.name"


def sun_times(date: dt.date) -> tuple[dt.datetime, dt.datetime]:
    # NOAA's approximate solar equations; times are UTC for the local date.
    days = 366 if calendar.isleap(date.year) else 365
    gamma = 2 * math.pi / days * (date.timetuple().tm_yday - 1)
    equation = 229.18 * (
        0.000075
        + 0.001868 * math.cos(gamma)
        - 0.032077 * math.sin(gamma)
        - 0.014615 * math.cos(2 * gamma)
        - 0.040849 * math.sin(2 * gamma)
    )
    declination = (
        0.006918
        - 0.399912 * math.cos(gamma)
        + 0.070257 * math.sin(gamma)
        - 0.006758 * math.cos(2 * gamma)
        + 0.000907 * math.sin(2 * gamma)
        - 0.002697 * math.cos(3 * gamma)
        + 0.00148 * math.sin(3 * gamma)
    )
    horizon = math.radians(90.833)
    hour_angle = math.degrees(
        math.acos(
            math.cos(horizon) / (math.cos(LATITUDE) * math.cos(declination))
            - math.tan(LATITUDE) * math.tan(declination)
        )
    )
    solar_noon = 720 - 4 * LONGITUDE - equation
    midnight = dt.datetime.combine(date, dt.time(), tzinfo=dt.timezone.utc)
    return (
        midnight + dt.timedelta(minutes=solar_noon - 4 * hour_angle),
        midnight + dt.timedelta(minutes=solar_noon + 4 * hour_angle),
    )


def main() -> None:
    now = dt.datetime.now(dt.timezone.utc)
    sunrise, sunset = sun_times(now.astimezone(HELSINKI).date())
    desired = "lupine" if sunrise <= now < sunset else "vaadin"
    current = CURRENT_THEME.read_text().strip() if CURRENT_THEME.exists() else ""
    if current != desired:
        subprocess.run(["omarchy", "theme", "set", desired], check=True)


if __name__ == "__main__":
    main()
