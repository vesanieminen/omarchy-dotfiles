#!/usr/bin/env bash
# Run as your desktop user, in the active Omarchy graphical session.
set -euo pipefail
repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
[[ $EUID != 0 ]] || { echo "Run bootstrap as your desktop user, not root." >&2; exit 1; }
command -v omarchy >/dev/null
# Fail before changing files if the desktop session is inaccessible.
hyprctl -j monitors >/dev/null
systemctl --user show-environment >/dev/null
"$repo_dir/scripts/install-packages"

backup_dir="$HOME/.local/state/dotfiles/backups/$(date +%Y%m%d-%H%M%S-%N)"
# Back up every conflicting file/link, including units and hooks on repeat installs.
# Never adopt live content into the repository, and never move a parent directory.
while IFS= read -r -d '' tracked; do
  relative=${tracked#"$repo_dir/desktop/"}
  target="$HOME/$relative"
  if [[ -L $target && $(readlink -f -- "$target") == "$tracked" ]]; then
    continue
  fi
  if [[ -e $target || -L $target ]]; then
    [[ ! -d $target || -L $target ]] || { echo "Directory conflicts with file: $target" >&2; exit 1; }
    mkdir -p -- "$backup_dir/$(dirname -- "$relative")"
    mv -- "$target" "$backup_dir/$relative"
    printf 'Backed up %s\n' "$relative"
  fi
done < <(find "$repo_dir/desktop" -type f -print0)

stow --dir="$repo_dir" --target="$HOME" --no-folding --restow desktop
systemctl --user daemon-reload
systemctl --user set-environment GDK_SCALE=1
hyprctl reload
errors=$(hyprctl configerrors)
[[ -z $errors ]] || { printf '%s\n' "$errors" >&2; exit 1; }
systemctl --user enable --now vm-display-scale.timer
systemctl --user start vm-display-scale.service

if [[ ! -d $HOME/.config/omarchy/themes/vaadin ]]; then
  omarchy theme install https://github.com/vesanieminen/omarchy-vaadin-theme.git
fi
systemctl --user enable --now auto-omarchy-theme.timer
systemctl --user start auto-omarchy-theme.service
"$repo_dir/scripts/remove-webapps"
omarchy restart terminal
"$repo_dir/scripts/validate"
printf 'Dotfiles applied. Backups (if needed): %s\n' "$backup_dir"
printf 'Open a new Foot window for the font change; log in again for session PATH.\n'
