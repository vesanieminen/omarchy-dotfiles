#!/usr/bin/env bash

set -euo pipefail

repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
backup_dir=""

backup_unmanaged_file() {
  local relative_path=$1
  local target="${HOME}/${relative_path}"
  local tracked="${repo_dir}/desktop/${relative_path}"

  [[ -f ${tracked} ]] || {
    printf 'Missing tracked file: %s\n' "${tracked}" >&2
    exit 1
  }

  if [[ -e ${target} && ! -L ${target} ]]; then
    if [[ -z ${backup_dir} ]]; then
      backup_dir="${HOME}/.local/state/dotfiles/backups/$(date +%Y%m%d-%H%M%S)"
    fi
    mkdir -p -- "$(dirname -- "${backup_dir}/${relative_path}")"
    mv -- "${target}" "${backup_dir}/${relative_path}"
    printf 'Backed up %s under %s\n' "${target}" "${backup_dir}"
  fi
}

command -v omarchy >/dev/null 2>&1 || {
  printf 'Omarchy is required before running this bootstrap.\n' >&2
  exit 1
}

"${repo_dir}/scripts/install-packages"

backup_unmanaged_file .config/hypr/monitors.lua
backup_unmanaged_file .config/hypr/input.lua
backup_unmanaged_file .bashrc
backup_unmanaged_file .local/bin/gh

stow --dir="${repo_dir}" --target="${HOME}" --restow desktop

systemctl --user daemon-reload
systemctl --user enable --now spice-display-scale.path
systemctl --user start spice-display-scale.service
systemctl --user set-environment GDK_SCALE=1

hyprctl reload
config_errors=$(hyprctl configerrors)
if [[ -n ${config_errors} ]]; then
  printf '%s\n' "${config_errors}" >&2
  exit 1
fi

printf 'Dotfiles applied and Hyprland configuration validated.\n'
