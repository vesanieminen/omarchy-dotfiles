#!/usr/bin/env bash
# Run as your desktop user, in the active Omarchy graphical session.
#
# Command record: official-VM migration, 2026-10-27.
# This block preserves the one-time setup, verification, and publication commands
# alongside the executable provisioning workflow below. Do not automatically
# replay branch creation, Git commits/pushes, or snapshot writes on installation.
# Exploratory file reads and failed connection/authentication attempts are not
# provisioning steps; the successful commands and their outcomes are recorded.
#
# Initial checkout and preservation of the previous setup:
#   git clone https://github.com/vesanieminen/omarchy-dotfiles.git ~/dotfiles
#   cd ~/dotfiles
#   git branch archive/custom-arm-vm-2026-10-27 3c8a63f6cfc802356fa22f5492d68749753f7f8d
#   gh auth status
#   git -c credential.helper= -c 'credential.helper=!gh auth git-credential' push origin archive/custom-arm-vm-2026-10-27
#
# Install Stow in this non-interactive agent session through desktop PolicyKit:
#   pkexec pacman -S --needed --noconfirm stow
# In an interactive terminal the executable workflow uses omarchy pkg add,
# which manages sudo itself. Both select the existing official repositories.
#
# Apply tracked configuration and confirm repeatability:
#   ./bootstrap
#   ./bootstrap
# Bootstrap executes the package helper, backup/link operations, user-service
# activation, first-install Vaadin theme installation, web-app exclusions,
# terminal reload, and validation shown below. The exact installed files and
# helper commands are versioned under desktop/ and scripts/.
#
# Verification performed after deployment:
#   ./scripts/validate
#   PYTHONDONTWRITEBYTECODE=1 python -m unittest discover -s tests
#   bash -n bootstrap scripts/install-packages scripts/validate scripts/remove-webapps desktop/.local/bin/gh desktop/.local/bin/with-claude-oauth desktop/.local/bin/omarchy-vm-clipboard-bridge
#   bash -n desktop/.bashrc desktop/.config/uwsm/env.d/90-dotfiles-path desktop/.config/omarchy/hooks/theme-set.d/vaadin-constellation
#   systemd-analyze --user verify ~/.config/systemd/user/vm-display-scale.service ~/.config/systemd/user/vm-display-scale.timer ~/.config/systemd/user/auto-omarchy-theme.service ~/.config/systemd/user/auto-omarchy-theme.timer
#   hyprctl configerrors
#   hyprctl -j monitors
#   hyprctl getoption input:kb_layout
#   hyprctl getoption input:kb_variant
#   hyprctl getoption input:natural_scroll
#   hyprctl getoption input:scroll_factor
#   systemctl --user list-timers vm-display-scale.timer auto-omarchy-theme.timer
#   systemctl --user show vm-display-scale.service auto-omarchy-theme.service -p Id -p Result
#   readlink -f ~/.local/state/omarchy/current/background
#   bash -ic 'command -v gh; gh api user --jq .login'
#   git -C ~/.config/omarchy/themes/vaadin rev-parse HEAD
# Confirm the helper's monitor API with the already-active mode (not a resize):
#   hyprctl eval 'hl.monitor({ output = "Virtual-1", mode = "3840x2160@60", position = "0x0", scale = 2, transform = 0 })'
#   hyprctl configerrors
#
# Record package audit data and publish the verified configuration:
#   ./scripts/snapshot-packages
#   git diff --check
#   git diff
#   git add README.md bootstrap desktop docs packages scripts tests
#   git diff --cached --check
#   git commit -m "Make official Omarchy VM the canonical dotfiles setup"
#   git -c credential.helper= -c 'credential.helper=!gh auth git-credential' push origin main
#   git status --short
#   git log -1 --format='%h %s'
#   git rev-parse main origin/main archive/custom-arm-vm-2026-10-27
#
# The published migration commit is c47c0aec921e505428034f8e1506264dd32dd341.
# Backups: ~/.local/state/dotfiles/backups/20261027-220437-340544958/
# Theme source: https://github.com/vesanieminen/omarchy-vaadin-theme.git
# Theme commit observed: 6941847158cac946c99bb465c736579542201fc6.
# No system repositories, kernel, bootloader, or Omarchy-owned files were edited.
# See docs/change-log.md for outcomes and README.md for recovery instructions.
#
# Executable provisioning workflow starts here.
set -euo pipefail
repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
[[ $EUID != 0 ]] || { echo "Run bootstrap as your desktop user, not root." >&2; exit 1; }
command -v omarchy >/dev/null
# Fail before changing files if the desktop session is inaccessible.
hyprctl -j monitors >/dev/null
systemctl --user show-environment >/dev/null
"$repo_dir/scripts/install-packages"

backup_dir="$HOME/.local/state/dotfiles/backups/$(date +%Y%m%d-%H%M%S-%N)"
# Back up every conflicting file/link, including units and hooks on repeat installs.
# Never adopt live content into the repository, and never move a parent directory.
while IFS= read -r -d '' tracked; do
  relative=${tracked#"$repo_dir/desktop/"}
  target="$HOME/$relative"
  if [[ -L $target && $(readlink -f -- "$target") == "$tracked" ]]; then
    continue
  fi
  if [[ -e $target || -L $target ]]; then
    [[ ! -d $target || -L $target ]] || { echo "Directory conflicts with file: $target" >&2; exit 1; }
    mkdir -p -- "$backup_dir/$(dirname -- "$relative")"
    mv -- "$target" "$backup_dir/$relative"
    printf 'Backed up %s\n' "$relative"
  fi
done < <(find "$repo_dir/desktop" -type f -print0)

stow --dir="$repo_dir" --target="$HOME" --no-folding --restow desktop
systemctl --user daemon-reload
# Apply the native display adapter to an already-running packaged SPICE agent.
systemctl --user try-restart spice-vdagent.service
systemctl --user set-environment GDK_SCALE=1
hyprctl reload
errors=$(hyprctl configerrors)
[[ -z $errors ]] || { printf '%s\n' "$errors" >&2; exit 1; }
systemctl --user enable --now vm-display-scale.timer
systemctl --user start vm-display-scale.service

if [[ ! -d $HOME/.config/omarchy/themes/vaadin ]]; then
  omarchy theme install https://github.com/vesanieminen/omarchy-vaadin-theme.git
fi
systemctl --user enable --now auto-omarchy-theme.timer
systemctl --user start auto-omarchy-theme.service
"$repo_dir/scripts/remove-webapps"
omarchy restart terminal
"$repo_dir/scripts/validate"
printf 'Dotfiles applied. Backups (if needed): %s\n' "$backup_dir"
printf 'Open a new Foot window for the font change; log in again for session PATH.\n'
